# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database (PostgreSQL recommended for production)
# Database (Supabase with Transaction Pooler for Prisma)
# Transaction pooler for connection pooling (recommended for Prisma)
DATABASE_URL="postgresql://postgres.USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=20&pool_timeout=30&connect_timeout=30"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres.USER:PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres?connect_timeout=30&pool_timeout=30"

# JWT
JWT_ACCESS_SECRET=change-me-to-a-long-random-access-secret
JWT_REFRESH_SECRET=change-me-to-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# File uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5
